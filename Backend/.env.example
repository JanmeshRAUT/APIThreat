PORT=3000
MONGODB_URI=mongodb+srv://<username>:<URL_ENCODED_PASSWORD>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# URL-encode special characters in the MongoDB password.
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-unique-password-at-least-12-characters
APP_URL=http://localhost:3000
TRUST_PROXY_HOPS=1
MAX_IN_MEMORY_RECORDS=5000
ALERT_WEBHOOK_URL=
HASH_IPS=false
IP_HASH_SALT=replace-with-a-random-secret
NODE_ENV=development