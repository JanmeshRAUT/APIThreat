PORT=3000
# Required: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
# URL-encode special characters in the password.
MONGODB_URI=
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_USER=admin
ADMIN_PASS=  # Set a unique 12+ character password
ALERT_WEBHOOK_URL=
MAX_IN_MEMORY_RECORDS=5000
HASH_IPS=false
IP_HASH_SALT=
TRUST_PROXY_HOPS=1
